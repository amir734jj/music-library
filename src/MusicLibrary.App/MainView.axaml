<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MusicLibrary.App" x:Class="MusicLibrary.App.MainView" x:Name="Root">
  <Grid>
    <local:AuthenticationView Name="AuthenticationView" IsVisible="False" Margin="24" />
    <Grid Name="ApplicationView" RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="3">
        <TextBlock Text="Music Library" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Live radio artist index" Opacity="0.65" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Name="CurrentUserStatus" VerticalAlignment="Center" Opacity="0.7" />
        <Border Classes="panel" Padding="8,4"><TextBlock Name="ApiConnectionStatus" Text="Starting" Foreground="#26834A" /></Border>
        <Button Name="SignOutButton" Content="Sign out" Click="SignOut_Click" IsVisible="False" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="240,16,*" RowDefinitions="*,Auto">
      <Border Classes="panel"><StackPanel Spacing="8"><TextBlock Text="Library" FontWeight="SemiBold" /><Button Content="Now playing" HorizontalContentAlignment="Left" Click="Library_Click" /><Button Content="Following" HorizontalContentAlignment="Left" /><Button Content="Trending" HorizontalContentAlignment="Left" /><Separator Name="AdministrationSeparator" Margin="0,6" IsVisible="False" /><Button Name="AdministrationButton" Content="Administration" HorizontalContentAlignment="Left" IsVisible="False" Click="Administration_Click" /></StackPanel></Border>
      <Grid Name="LibraryView" Grid.Column="2" RowDefinitions="Auto,12,*,12,Auto">
        <TextBox Name="LibrarySearchInput" PlaceholderText="Search artist, track, or station" TextChanged="LibrarySearchInput_TextChanged" />
        <Border Grid.Row="2" Classes="panel">
          <Grid RowDefinitions="Auto,8,Auto,8,*">
            <TextBlock Text="Now Playing" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Name="NowPlayingStatus" Text="Loading live observations..." Opacity="0.7" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="NowPlayingList" />
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Row="4" Classes="panel" IsVisible="{Binding ShowNativeMedia, ElementName=Root}">
          <Grid ColumnDefinitions="*,8,100,8,Auto,8,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
            <TextBlock Grid.ColumnSpan="7" Text="Live station" FontWeight="SemiBold" />
            <TextBox Grid.Row="2" Name="StreamUrlInput" PlaceholderText="https://station.example/stream" />
            <TextBox Grid.Row="2" Grid.Column="2" Name="RecordingSecondsInput" Text="300" PlaceholderText="Seconds" />
            <Button Grid.Row="2" Grid.Column="4" Content="Listen" Click="Listen_Click" />
            <Button Grid.Row="2" Grid.Column="6" Content="Download" Click="Download_Click" />
            <TextBlock Grid.Row="4" Grid.ColumnSpan="7" Name="NativeMediaStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>
      <Grid Name="AdministrationView" Grid.Column="2" IsVisible="False" RowDefinitions="Auto,12,*">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="Administration" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Accounts and access roles" Opacity="0.65" />
          </StackPanel>
          <Button Grid.Column="1" Content="Back to library" Click="Library_Click" />
        </Grid>
        <Border Grid.Row="2" Classes="panel">
          <Grid RowDefinitions="Auto,Auto,Auto,*,16,Auto,Auto,Auto,*">
            <TextBlock Text="Users" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Manage account access and administrator privileges." Opacity="0.65" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Name="AdministrationStatus" Opacity="0.7" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="3" MinHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="AdminUsersList" />
            </ScrollViewer>
            <Separator Grid.Row="4" VerticalAlignment="Center" />
            <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
              <TextBlock Text="Shoutcast probes" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Refresh status" Click="RefreshProbeStatus_Click" />
            </Grid>
            <TextBlock Grid.Row="6" Text="Current worker activity and station metadata health." Opacity="0.65" TextWrapping="Wrap" />
            <TextBlock Grid.Row="7" Name="ProbeStatus" Opacity="0.7" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="8" MinHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="ProbeStationsList" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    </Grid>
  </Grid>
</UserControl>