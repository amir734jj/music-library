<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MusicLibrary.App" x:Class="MusicLibrary.App.MainView" x:Name="Root" SizeChanged="MainView_SizeChanged">
  <Grid>
    <local:AuthenticationView Name="AuthenticationView" IsVisible="False" Margin="24" />
    <Grid Name="ApplicationView" RowDefinitions="Auto,*" Margin="16">
    <Grid Name="HeaderGrid" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="3">
        <TextBlock Text="Music Library" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Live radio artist index" Opacity="0.65" />
      </StackPanel>
      <StackPanel Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Name="CurrentUserStatus" VerticalAlignment="Center" Opacity="0.7" />
        <Border Classes="panel" Padding="8,4"><TextBlock Name="ApiConnectionStatus" Text="Starting" Foreground="#26834A" /></Border>
        <Button Name="SignOutButton" Content="Sign out" Click="SignOut_Click" IsVisible="False" />
      </StackPanel>
    </Grid>
    <Grid Name="MainShell" Grid.Row="1" ColumnDefinitions="240,16,*" RowDefinitions="*,12,Auto">
      <Border Name="LibraryNavigation" Classes="panel">
        <ScrollViewer Name="LibraryNavigationScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
          <StackPanel Name="LibraryNavigationPanel" Spacing="8">
            <TextBlock Name="LibraryNavigationTitle" Text="Library" FontWeight="SemiBold" />
            <Button Name="NowPlayingNavigationButton" Classes="nav" Content="Now playing" HorizontalContentAlignment="Left" Click="Library_Click" />
            <Button Name="FollowingNavigationButton" Classes="nav" Content="Following" HorizontalContentAlignment="Left" Click="Following_Click" />
            <Button Name="TrendingNavigationButton" Classes="nav" Content="Trending" HorizontalContentAlignment="Left" Click="Trending_Click" />
            <Button Name="UserBoardNavigationButton" Classes="nav" Content="User board" HorizontalContentAlignment="Left" Click="UserBoard_Click" />
            <Button Name="AboutNavigationButton" Classes="nav" Content="About" HorizontalContentAlignment="Left" Click="About_Click" />
            <Separator Name="AdministrationSeparator" Margin="0,6" IsVisible="False" />
            <Button Name="AdministrationButton" Content="Administration" HorizontalContentAlignment="Left" IsVisible="False" Click="Administration_Click" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Name="LibraryView" Grid.Column="2" RowDefinitions="Auto,12,*,12,Auto">
        <TextBox Name="LibrarySearchInput" PlaceholderText="Search artist, track, or station" TextChanged="LibrarySearchInput_TextChanged" />
        <Border Grid.Row="2" Classes="panel">
          <Grid RowDefinitions="Auto,8,Auto,8,*">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <TextBlock Name="LibraryViewTitle" Text="Now Playing" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Name="PlayAllTrendingButton" Grid.Column="1" IsVisible="False" Click="PlayAllTrending_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="16" Height="16" />
                  <TextBlock Name="PlayAllTrendingButtonText" Text="Play all" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="DownloadAllTrendingButton" Grid.Column="3" Content="Download all" IsVisible="False" Click="DownloadAllTrending_Click" />
            </Grid>
            <TextBlock Grid.Row="2" Name="NowPlayingStatus" Text="Loading live observations..." Opacity="0.7" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="4" Name="NowPlayingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="NowPlayingList" Margin="0,0,16,0" />
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Row="4" Classes="panel" IsVisible="{Binding ShowNativeMedia, ElementName=Root}">
          <Grid ColumnDefinitions="*,8,100,8,Auto,8,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
            <TextBlock Grid.ColumnSpan="7" Text="Live station" FontWeight="SemiBold" />
            <TextBox Grid.Row="2" Name="StreamUrlInput" PlaceholderText="https://station.example/stream" />
            <TextBox Grid.Row="2" Grid.Column="2" Name="RecordingSecondsInput" Text="300" PlaceholderText="Seconds" />
            <Button Name="ListenButton" Grid.Row="2" Grid.Column="4" Content="Listen" Click="Listen_Click" />
            <Button Name="DownloadButton" Grid.Row="2" Grid.Column="6" Content="Download" Click="Download_Click" />
            <TextBlock Grid.Row="4" Grid.ColumnSpan="7" Name="NativeMediaStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>
      <Grid Name="AdministrationView" Grid.Column="2" IsVisible="False" RowDefinitions="Auto,12,*">
        <Grid Name="AdministrationHeader" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="Administration" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Accounts, probing, and global settings" Opacity="0.65" />
          </StackPanel>
          <Button Name="BackToLibraryButton" Grid.Column="1" Content="Back to library" Click="Library_Click" />
        </Grid>
        <Border Grid.Row="2" Classes="panel">
          <TabControl>
            <TabItem Header="Users">
              <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
                <TextBlock Text="Manage account access and administrator privileges." Opacity="0.65" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Name="AdministrationStatus" Opacity="0.7" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" MinHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl Name="AdminUsersList" />
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="Probing">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,10,0,0">
                <Grid RowDefinitions="Auto,Auto">
                  <TextBlock Text="Shoutcast probes" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Name="ImportStationsButton" Content="Import stations" Margin="0,0,8,8" Click="ImportStations_Click" />
                    <Button Name="ProbeWorkerToggleButton" Content="Loading worker..." IsEnabled="False" Margin="0,0,8,8" Click="ToggleProbeWorker_Click" />
                    <Button Name="StationProbesToggleButton" Content="Loading stations..." IsEnabled="False" Margin="0,0,8,8" Click="ToggleAllStationProbes_Click" />
                    <Button Name="RefreshProbeStatusButton" Content="Refresh status" Margin="0,0,0,8" Click="RefreshProbeStatus_Click" />
                  </WrapPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="Current worker activity and station metadata health." Opacity="0.65" TextWrapping="Wrap" />
                <TextBox Grid.Row="2" Name="ProbeStationSearchInput" PlaceholderText="Search station, genre, or URL" TextChanged="ProbeStationSearchInput_TextChanged" />
                <TextBlock Grid.Row="3" Name="ProbeStatus" Opacity="0.7" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="4" Name="ProbeStationsScroll" MinHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl Name="ProbeStationsList" />
                </ScrollViewer>
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                  <Button Name="PreviousProbePageButton" Content="Previous" Click="PreviousProbePage_Click" />
                  <TextBlock Name="ProbePageStatus" VerticalAlignment="Center" />
                  <Button Name="NextProbePageButton" Content="Next" Click="NextProbePage_Click" />
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Global config">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,0,0">
                  <TextBlock Text="Directory artifact URL" FontWeight="SemiBold" />
                  <TextBox Name="ConfigDirectoryArtifactUrlInput" />
                  <CheckBox Name="ConfigProbingEnabledInput" Content="Enable background probing" />
                  <TextBlock Text="Probe concurrency" FontWeight="SemiBold" />
                  <TextBlock Text="Maximum number of station streams checked at the same time." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                  <NumericUpDown Name="ConfigProbeConcurrencyInput" Minimum="1" Maximum="100" Increment="1" />
                  <TextBlock Text="Probe timeout (seconds)" FontWeight="SemiBold" />
                  <TextBlock Text="Maximum time allowed for one station to return song metadata." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                  <NumericUpDown Name="ConfigProbeTimeoutInput" Minimum="2" Maximum="60" Increment="1" />
                  <TextBlock Text="Stations per batch" FontWeight="SemiBold" />
                  <NumericUpDown Name="ConfigProbeBatchSizeInput" Minimum="1" Maximum="1000" Increment="1" />
                  <TextBlock Text="Trending cache encryption key (Base64)" FontWeight="SemiBold" />
                  <TextBox Name="ConfigTrendingCacheEncryptionKeyInput" PasswordChar="*" />
                  <CheckBox Name="ShowTrendingCacheEncryptionKeyInput" Content="Show encryption key" Click="ShowTrendingCacheEncryptionKey_Click" />
                  <TextBlock Text="Song boundary wait timeout (seconds)" FontWeight="SemiBold" />
                  <NumericUpDown Name="ConfigTrendingCacheCaptureTimeoutInput" Minimum="60" Maximum="1800" Increment="60" />
                  <TextBlock Text="Trending cache retention (hours)" FontWeight="SemiBold" />
                  <NumericUpDown Name="ConfigTrendingCacheRetentionInput" Minimum="1" Maximum="168" Increment="1" />
                  <TextBlock Text="Trending cache maximum size (MiB)" FontWeight="SemiBold" />
                  <NumericUpDown Name="ConfigTrendingCacheMaxSizeInput" Minimum="32" Maximum="1024" Increment="64" />
                  <TextBlock Name="ConfigTrendingCacheStatus" Text="Current cache: loading..." Opacity="0.7" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Name="SaveGlobalConfigButton" Content="Save configuration" Margin="0,0,8,8" Click="SaveGlobalConfig_Click" />
                    <Button Name="ReloadGlobalConfigButton" Content="Reload" Margin="0,0,8,8" Click="ReloadGlobalConfig_Click" />
                    <Button Name="ClearTrendingCacheButton" Content="Clear cache" Margin="0,0,0,8" Click="ClearTrendingCache_Click" />
                  </WrapPanel>
                  <TextBlock Name="GlobalConfigStatus" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      <Border Name="PlaybackDock" Grid.Row="2" Grid.ColumnSpan="3" Classes="panel" IsVisible="False">
        <Grid ColumnDefinitions="Auto,12,*,12,Auto">
          <PathIcon Name="PlaybackDockIcon" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="20" Height="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
            <TextBlock Name="PlaybackDockTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="PlaybackDockSubtitle" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Name="PlaybackDockButton" Grid.Column="4" Width="40" Height="36" Click="PlaybackDockButton_Click" />
        </Grid>
      </Border>
    </Grid>
    </Grid>
  </Grid>
</UserControl>