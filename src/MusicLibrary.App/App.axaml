<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MusicLibrary.App.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.panel">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="#30808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#263A7D44" />
    </Style>
  </Application.Styles>
</Application>