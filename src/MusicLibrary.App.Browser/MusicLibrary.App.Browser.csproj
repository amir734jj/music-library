<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-browser</TargetFramework><RootNamespace>MusicLibrary.App.Browser</RootNamespace></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\MusicLibrary.App\MusicLibrary.App.csproj" /><PackageReference Include="Avalonia.Browser" Version="12.1.2" /></ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**">
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
